{"@timestamp":"2026-08-07T01:16:21.762919904+09:00","@version":"1","message":"SELECT total_courses, sequence,\n       p10_click_course, p30_click_course, p50_click_course, p70_click_course,\n       p10_click_yes, p30_click_yes, p50_click_yes, p70_click_yes,\n       p10_click_ok, p30_click_ok, p50_click_ok, p70_click_ok,\n       p10_total, p30_total, p50_total, p70_total\nFROM v_sequence_percentile_stats\nWHERE total_courses = ?\nORDER BY sequence ASC\n","logger_name":"org.hibernate.SQL","thread_name":"http-nio-8080-exec-9","level":"DEBUG","level_value":10000,"INSTANCE_ID":"app","requestId":"57dde939-7ed1-480e-82a9-2736abe7deb2","instanceId":"window-7600"}
